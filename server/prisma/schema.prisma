generator client {
  provider = "prisma-client-js"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  games Game[]
}

model Game {
  id    Int    @id @default(autoincrement())
  uuid  String @unique @default(uuid())
  users User[]
}
